{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://alehcrim-anime-pipeline.hf.space/seo/api/:path*"
    },
    {
      "source": "/output-img/:path*",
      "destination": "https://alehcrim-anime-pipeline.hf.space/seo/output-img/:path*"
    },
    {
      "source": "/extracted/:path*",
      "destination": "https://alehcrim-anime-pipeline.hf.space/seo/extracted/:path*"
    }
  ]
}
